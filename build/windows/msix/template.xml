<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="fastv.exe"
        Arguments=""
        InstallLocation="C:\Program Files\FastV\FastV">
    </Installer>
    <PackageInformation
        PackageName="FastV"
        PackageDisplayName="FastV"
        PublisherName="CN=FastV"
        PublisherDisplayName="FastV"
        Version="0.1.0.0"
        PackageDescription="A modern proxy client built with Wails v3">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.mardukprime.fastv"
                Description="A modern proxy client built with Wails v3"
                DisplayName="FastV"
                ExecutableName="fastv.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>FastV</DisplayName>
            <PublisherDisplayName>FastV</PublisherDisplayName>
            <Description>A modern proxy client built with Wails v3</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="fastv.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
