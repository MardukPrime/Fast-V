# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
!coverage.go
*.coverprofile
profile.cov

# Dependency directories
# vendor/

# Go workspace file
go.work
go.work.sum

# Env files
.env
.env.*
!.env.example

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Local tooling and bootstrap worktrees
.tools/
.repo/

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Build configuration and platform assets are local-only
/build/
/Taskfile.yml
/.github/workflows/

# Build outputs
build/bin/
dist/
*.log

# Runtime application data
data.db
data.db-*
runtime/
logs/
proxy_backup.json

# Wails generated artifacts that can be regenerated
# frontend/bindings/
# frontend/wailsjs/

# Wails local state
.task/
.wails/
bin/
frontend/dist/
frontend/node_modules/

# Wails build intermediates
*.syso
*.manifest
